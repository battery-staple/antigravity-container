#!/bin/bash
set -e

CALLER_PWD="$PWD"

# Robust symlink resolution for DIR
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.orbstack/bin:$HOME/.docker/bin:$PATH"

COMMAND="$1"
shift || true

SANDBOX_DIR="$HOME/.antigravity-sandbox"
VENV_DIR="$SANDBOX_DIR/.venv"
PYTHON_BIN=""
WHITELIST_FILE="$SANDBOX_DIR/whitelist.yaml"
DEFAULT_WHITELIST_FILE="$DIR/config/whitelist.default.yaml"
LEGACY_WHITELIST_FILE="$SANDBOX_DIR/whitelist.json"
REPO_LEGACY_WHITELIST_FILE="$DIR/config/whitelist.json"
OVERRIDE_COMPOSE_FILE="$SANDBOX_DIR/docker-compose.override.yml"
IPC_DIR="$SANDBOX_DIR/ipc"
LOGS_DIR="$SANDBOX_DIR/logs"
HOST_BRIDGE_PID_FILE="$IPC_DIR/host-bridge.pid"
HOST_BRIDGE_LOG_FILE="$LOGS_DIR/host_exec_daemon.log"

function ensure_sandbox_venv() {
  if [ -n "$PYTHON_BIN" ] && [ -x "$PYTHON_BIN" ]; then
    return 0
  fi

  local venv_py="$VENV_DIR/bin/python3"
  if [ -x "$venv_py" ] && "$venv_py" -c "import yaml" 2>/dev/null; then
    PYTHON_BIN="$venv_py"
    return 0
  fi

  local host_py
  host_py="$(which python3 2>/dev/null || true)"
  if [ -z "$host_py" ]; then
    echo "[Sandbox Error] Python 3 is required on host but was not found in PATH." >&2
    exit 1
  fi

  mkdir -p "$SANDBOX_DIR" 2>/dev/null || true
  if [ ! -x "$venv_py" ]; then
    echo "[Sandbox] Initializing isolated CLI tool environment ($VENV_DIR)..." >&2
    "$host_py" -m venv "$VENV_DIR"
  fi

  if ! "$venv_py" -c "import yaml" 2>/dev/null; then
    echo "[Sandbox] Installing dependencies (pyyaml) in tool environment..." >&2
    "$VENV_DIR/bin/pip" install --quiet --disable-pip-version-check pyyaml
  fi

  PYTHON_BIN="$venv_py"
}

function run_compose() {
  local compose_args=("-f" "$DIR/docker-compose.yml")
  if [ -f "$OVERRIDE_COMPOSE_FILE" ]; then
    compose_args+=("-f" "$OVERRIDE_COMPOSE_FILE")
  fi
  HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose "${compose_args[@]}" "$@"
}

function get_host_bridge_pid() {
  if [ -f "$HOST_BRIDGE_PID_FILE" ]; then
    local pid
    pid="$(cat "$HOST_BRIDGE_PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      local cmd_line
      cmd_line="$( (ps -ww -p "$pid" -o command= 2>/dev/null || ps -ww -p "$pid" -o args= 2>/dev/null || ps -p "$pid" -o command= 2>/dev/null || true) )"
      if echo "$cmd_line" | grep -q "host_exec_daemon"; then
        echo "$pid"
        return 0
      fi
    fi
  fi
  # Fallback: check pgrep if pid file was missing or stale
  local found_pid
  found_pid="$(pgrep -f "host_exec_daemon.py" 2>/dev/null | head -n 1 || true)"
  if [ -n "$found_pid" ] && kill -0 "$found_pid" 2>/dev/null; then
    mkdir -p "$IPC_DIR" 2>/dev/null || true
    echo "$found_pid" > "$HOST_BRIDGE_PID_FILE" 2>/dev/null || true
    echo "$found_pid"
    return 0
  fi
  return 1
}

function is_host_bridge_running() {
  local pid
  pid="$(get_host_bridge_pid 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    return 0
  fi
  return 1
}

function start_host_bridge_bg() {
  ensure_sandbox_venv
  ensure_whitelist_config

  if is_host_bridge_running; then
    local current_pid
    current_pid="$(get_host_bridge_pid 2>/dev/null || true)"
    echo "[Bridge] Host-Exec daemon is already running (PID: $current_pid)."
    return 0
  fi

  echo "[Bridge] Spawning Host-Exec daemon in background..."
  mkdir -p "$LOGS_DIR" "$IPC_DIR" 2>/dev/null || true

  # Clean up stale socket if no daemon is running
  if [ -e "$IPC_DIR/host-exec.sock" ]; then
    rm -f "$IPC_DIR/host-exec.sock" 2>/dev/null || true
  fi

  nohup "$PYTHON_BIN" "$DIR/bridge/host_exec_daemon.py" < /dev/null >> "$HOST_BRIDGE_LOG_FILE" 2>&1 &
  local bg_pid=$!
  echo "$bg_pid" > "$HOST_BRIDGE_PID_FILE" 2>/dev/null || true

  # Wait up to 2 seconds to verify daemon started
  local count=0
  local started="false"
  while [ $count -lt 20 ]; do
    if kill -0 "$bg_pid" 2>/dev/null; then
      if [ -S "$IPC_DIR/host-exec.sock" ] || nc -z 127.0.0.1 58433 2>/dev/null || (lsof -iTCP:58433 -sTCP:LISTEN -n -P 2>/dev/null | grep -q "$bg_pid"); then
        started="true"
        break
      fi
    else
      break
    fi
    sleep 0.1
    count=$((count + 1))
  done

  if kill -0 "$bg_pid" 2>/dev/null; then
    echo "[Bridge] Host-Exec daemon started in background (PID: $bg_pid, listening on port 58433)."
  else
    echo "[Bridge Warning] Host-Exec daemon failed to start. Check logs at: $HOST_BRIDGE_LOG_FILE" >&2
  fi
}

function stop_host_bridge() {
  local pid
  pid="$(get_host_bridge_pid 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    echo "[Bridge] Stopping Host-Exec daemon (PID: $pid)..."
    kill "$pid" 2>/dev/null || true
    local count=0
    while kill -0 "$pid" 2>/dev/null && [ $count -lt 30 ]; do
      sleep 0.1
      count=$((count + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "[Bridge Warning] Daemon did not exit cleanly, sending SIGKILL..."
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$HOST_BRIDGE_PID_FILE" "$IPC_DIR/host-exec.sock" 2>/dev/null || true
    echo "[Bridge] Host-Exec daemon stopped."
  else
    rm -f "$HOST_BRIDGE_PID_FILE" "$IPC_DIR/host-exec.sock" 2>/dev/null || true
  fi
}

function show_help() {
  echo "=========================================================="
  echo "  Antigravity Sandbox Manager CLI"
  echo "=========================================================="
  echo "Usage: antigravity-sandbox <command> [options]"
  echo ""
  echo "Workspace Management Commands:"
  echo "  workspace add [path] [-y|--force]   Whitelist a workspace directory (defaults to current dir)"
  echo "  workspace remove <path>             Remove a workspace directory from whitelist"
  echo "  workspace list                      List all currently whitelisted workspaces"
  echo "  (Aliases: ws add, ws rm, ws ls)"
  echo ""
  echo "Skills Commands:"
  echo "  skills                              Display discovered skills.json configs and read-only mounts"
  echo "  (Alias: skills list)"
  echo ""
  echo "Rules Commands:"
  echo "  rules                               Display active rules and compiled GEMINI.md status"
  echo "  (Alias: rules list)"
  echo ""
  echo "Core Commands:"
  echo "  start [--no-host-bridge]            Start the sandbox container with whitelisted workspaces"
  echo "  stop                                Stop the sandbox container and host bridge daemon"
  echo "  restart [--no-host-bridge]          Restart the sandbox container and host bridge daemon"
  echo "  build                               Rebuild the sandbox container image (after Dockerfile edits)"
  echo "  status                              Display current sandbox status and resource usage"
  echo "  app                                 Launch Antigravity Desktop App connected to Sandbox"
  echo "  open [subpath]                      Open ~/.antigravity-sandbox directory (or subpath) in file manager"
  echo "  host-bridge [start|stop|restart|status|fg]"
  echo "                                      Manage or start the host binary execution bridge daemon"
  echo "  help                                Show this help message"
  echo "=========================================================="
}

function ensure_whitelist_config() {
  ensure_sandbox_venv
  local gemini_host_dir="${HOST_GEMINI_DIR:-$HOME/.gemini}"
  local user_rules_dir="${HOST_SANDBOX_RULES_DIR:-$SANDBOX_DIR/rules}"
  local sandbox_gemini="${HOST_SANDBOX_GEMINI:-$SANDBOX_DIR/GEMINI.md}"
  local host_gemini="$gemini_host_dir/GEMINI.md"
  mkdir -p "$SANDBOX_DIR" "$user_rules_dir" "$IPC_DIR" "$LOGS_DIR" "$gemini_host_dir/antigravity/brain" "$gemini_host_dir/sandbox-tmp" 2>/dev/null || true
  if [ -d "$host_gemini" ]; then
    if ! rmdir "$host_gemini" 2>/dev/null; then
      echo "[Sandbox Error] '$host_gemini' is a non-empty directory." >&2
      echo "[Sandbox Error] Expected a file for GEMINI.md, but found a directory containing files. Please remove or move this directory before starting the sandbox." >&2
      exit 1
    fi
  fi
  if [ -d "$sandbox_gemini" ]; then
    if ! rmdir "$sandbox_gemini" 2>/dev/null; then
      echo "[Sandbox Error] '$sandbox_gemini' is a non-empty directory." >&2
      echo "[Sandbox Error] Expected a file for GEMINI.md, but found a directory containing files. Please remove or move this directory before starting the sandbox." >&2
      exit 1
    fi
  fi
  touch "$sandbox_gemini" "$host_gemini" 2>/dev/null || true
  chmod 0700 "$IPC_DIR" 2>/dev/null || true

  "$PYTHON_BIN" -c "
import os, sys, shutil, yaml

cfg = '$WHITELIST_FILE'
legacy_cfg = '$LEGACY_WHITELIST_FILE'
repo_legacy_cfg = '$REPO_LEGACY_WHITELIST_FILE'
default_cfg = '$DEFAULT_WHITELIST_FILE'

def migrate_legacy_json(json_path):
    if os.path.exists(json_path):
        try:
            import json
            with open(json_path, 'r') as f:
                data = json.load(f)
            if data:
                os.makedirs(os.path.dirname(cfg), exist_ok=True)
                with open(cfg, 'w') as f:
                    yaml.safe_dump(data, f, default_flow_style=False, sort_keys=False)
                os.remove(json_path)
                return True
        except Exception:
            pass
    return False

if not os.path.exists(cfg):
    # 1. One-time migration: Convert legacy JSON to YAML if found
    if migrate_legacy_json(legacy_cfg) or migrate_legacy_json(repo_legacy_cfg):
        sys.exit(0)

    # 2. Copy from default template config/whitelist.default.yaml
    if os.path.exists(default_cfg):
        try:
            shutil.copyfile(default_cfg, cfg)
            sys.exit(0)
        except Exception:
            pass

    # 3. Fallback default YAML policy
    default_data = {
        'allowed_workspaces': [],
        'allowed_commands': {
            'xcodebuild': {
                'binary_path': '/usr/bin/xcodebuild',
                'allowed_args_regex': '^' + '(-version|-showsdks|-list.*)' + '$',
                'require_interactive_approval': False,
                'description': 'Apple Xcode build system and SDK inspection'
            },
            'simulator': {
                'binary_path': '/usr/bin/open',
                'allowed_args_regex': '^-a Simulator$',
                'require_interactive_approval': False,
                'description': 'Launch Apple iOS Simulator'
            },
            'git-credential-osxkeychain': {
                'binary_path': '/usr/bin/git',
                'allowed_args_regex': '^credential-osxkeychain (get|store|erase)$',
                'require_interactive_approval': True,
                'description': 'macOS Keychain Git credential helper'
            },
            'sw_vers': {
                'binary_path': '/usr/bin/sw_vers',
                'allowed_args_regex': '^.*$',
                'require_interactive_approval': False,
                'description': 'macOS system version information'
            }
        }
    }
    os.makedirs(os.path.dirname(cfg), exist_ok=True)
    with open(cfg, 'w') as f:
        yaml.safe_dump(default_data, f, default_flow_style=False, sort_keys=False)
"
}

function generate_compose_override() {
  ensure_sandbox_venv
  ensure_whitelist_config
  local gemini_host_dir="${HOST_GEMINI_DIR:-$HOME/.gemini}"
  "$PYTHON_BIN" "$DIR/scripts/skills_mount.py" \
    --whitelist "$WHITELIST_FILE" \
    --override-file "$OVERRIDE_COMPOSE_FILE" \
    --gemini-dir "$gemini_host_dir" \
    --generate
}

function compile_sandbox_rules() {
  ensure_sandbox_venv
  ensure_whitelist_config
  local gemini_host_dir="${HOST_GEMINI_DIR:-$HOME/.gemini}"
  local builtin_rules_dir="$DIR/customizations/rules"
  local user_rules_dir="${HOST_SANDBOX_RULES_DIR:-$SANDBOX_DIR/rules}"
  local sandbox_gemini="${HOST_SANDBOX_GEMINI:-$SANDBOX_DIR/GEMINI.md}"
  local host_gemini="$gemini_host_dir/GEMINI.md"

  "$PYTHON_BIN" -c "
import os, sys

builtin_dir = '$builtin_rules_dir'
user_dir = '$user_rules_dir'
host_gemini_file = '$host_gemini'
target_gemini_file = '$sandbox_gemini'

sections = []

# 1. Built-in Container Rules (e.g. container-environment.md)
if os.path.isdir(builtin_dir):
    for f in sorted(os.listdir(builtin_dir)):
        if not f.startswith('.') and f.lower().endswith('.md'):
            p = os.path.join(builtin_dir, f)
            if os.path.isfile(p):
                try:
                    with open(p, 'r', encoding='utf-8') as rf:
                        content = rf.read().strip()
                    if content:
                        sections.append(f'<!-- BUILT-IN CONTAINER RULE: {f} -->\n{content}')
                except Exception as e:
                    print(f'[Sandbox Warning] Failed to read built-in rule {p}: {e}', file=sys.stderr)

# 2. User Sandbox-Specific Rules (~/.antigravity-sandbox/rules/*.md)
if os.path.isdir(user_dir):
    for f in sorted(os.listdir(user_dir)):
        if not f.startswith('.') and f.lower().endswith('.md'):
            p = os.path.join(user_dir, f)
            if os.path.isfile(p):
                try:
                    with open(p, 'r', encoding='utf-8') as rf:
                        content = rf.read().strip()
                    if content:
                        sections.append(f'<!-- USER SANDBOX RULE: {f} -->\n{content}')
                except Exception as e:
                    print(f'[Sandbox Warning] Failed to read user sandbox rule {p}: {e}', file=sys.stderr)

# 3. Host Global Rules (~/.gemini/GEMINI.md, if present on macOS)
if os.path.isfile(host_gemini_file):
    try:
        with open(host_gemini_file, 'r', encoding='utf-8') as rf:
            content = rf.read().strip()
        if content:
            sections.append(f'<!-- HOST GLOBAL RULES (macOS ~/.gemini/GEMINI.md) -->\n{content}')
    except Exception as e:
        print(f'[Sandbox Warning] Failed to read host GEMINI.md: {e}', file=sys.stderr)

output = '\n\n---\n\n'.join(sections) + '\n' if sections else '# Antigravity Container Sandbox Rules\n'
try:
    os.makedirs(os.path.dirname(os.path.abspath(target_gemini_file)), exist_ok=True)
    with open(target_gemini_file, 'w', encoding='utf-8') as f:
        f.write(output)
except Exception as e:
    print(f'[Sandbox Error] Failed to write compiled GEMINI.md: {e}', file=sys.stderr)
    sys.exit(1)
"
}

function is_container_running() {
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^antigravity-sandbox$"; then
    return 0
  else
    return 1
  fi
}

function reload_container_if_running() {
  if is_container_running; then
    echo "[Sandbox] Updating running container mounts..."
    run_compose up -d
    echo "[Sandbox] Container updated successfully."
  fi
}

function normalize_and_validate_path() {
  local input_path="$1"
  local force_flag="$2"
  
  if [ -z "$input_path" ]; then
    input_path="$CALLER_PWD"
  fi

  ensure_sandbox_venv
  local path_status
  path_status="$("$PYTHON_BIN" -c "
import os, sys
p = sys.argv[1]
expanded = os.path.abspath(os.path.expanduser(p))
if os.path.isdir(expanded):
    print('DIR:' + expanded)
elif os.path.exists(expanded):
    print('EXISTS_NOT_DIR:' + expanded)
else:
    print('NOT_FOUND:' + expanded)
" "$input_path" 2>/dev/null || true)"

  if [ -z "$path_status" ]; then
    echo "[Error] Failed to resolve path: $input_path" >&2
    return 1
  fi

  local status_type="${path_status%%:*}"
  local resolved_path="${path_status#*:}"

  if [ "$status_type" = "EXISTS_NOT_DIR" ]; then
    echo "[Error] Path exists but is not a directory: $resolved_path" >&2
    return 1
  elif [ "$status_type" = "NOT_FOUND" ]; then
    if [ "$force_flag" = "true" ]; then
      echo "[Sandbox] Path does not exist: $resolved_path" >&2
      if mkdir -p "$resolved_path" 2>/dev/null; then
        echo "[Sandbox] Created directory: $resolved_path" >&2
      else
        echo "[Error] Failed to create directory: $resolved_path" >&2
        return 1
      fi
    else
      echo "[Sandbox Warning] Path does not exist: $resolved_path" >&2
      read -p "Directory does not exist. Would you like to create it? (y/N): " -r confirm >&2
      case "$confirm" in
        [yY]|[yY][eE][sS])
          if mkdir -p "$resolved_path" 2>/dev/null; then
            echo "[Sandbox] Created directory: $resolved_path" >&2
          else
            echo "[Error] Failed to create directory: $resolved_path" >&2
            return 1
          fi
          ;;
        *)
          echo "[Sandbox] Operation cancelled." >&2
          return 1
          ;;
      esac
    fi
  fi

  # Check dangerous roots
  local is_dangerous="false"
  case "$resolved_path" in
    "/"|"/Users"|"/home"|"$HOME"|"/Applications"|"/System"|"/Library"|"/usr"|"/bin"|"/sbin")
      is_dangerous="true"
      ;;
  esac

  if [ "$is_dangerous" = "true" ] && [ "$force_flag" != "true" ]; then
    echo "[Sandbox Warning] '$resolved_path' is a broad system/user root directory." >&2
    echo "[Sandbox Warning] Whitelisting this path grants the container access to all files within it." >&2
    read -p "Are you sure you want to whitelist this path? (y/N): " -r confirm >&2
    case "$confirm" in
      [yY]|[yY][eE][sS])
        ;;
      *)
        echo "[Sandbox] Operation cancelled." >&2
        return 1
        ;;
    esac
  fi

  echo "$resolved_path"
}

function cmd_workspace_add() {
  local target_raw=""
  local force_flag="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--force)
        force_flag="true"
        shift
        ;;
      *)
        if [ -z "$target_raw" ]; then
          target_raw="$1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$target_raw" ]; then
    target_raw="$CALLER_PWD"
  fi

  local target_path
  target_path="$(normalize_and_validate_path "$target_raw" "$force_flag")" || return 1
  if [ -z "$target_path" ]; then
    return 1
  fi

  ensure_sandbox_venv
  ensure_whitelist_config

  local add_result
  add_result="$("$PYTHON_BIN" -c "
import os, sys, yaml
cfg = '$WHITELIST_FILE'
target = sys.argv[1]
with open(cfg, 'r') as f:
    data = yaml.safe_load(f) or {}
workspaces = data.get('allowed_workspaces', [])
if target in workspaces:
    print('ALREADY_EXISTS')
    sys.exit(0)
workspaces.append(target)
data['allowed_workspaces'] = workspaces
with open(cfg, 'w') as f:
    yaml.safe_dump(data, f, default_flow_style=False, sort_keys=False)
print('ADDED')
" "$target_path")"

  if [ "$add_result" = "ALREADY_EXISTS" ]; then
    echo "[Sandbox] Workspace is already whitelisted: $target_path"
  else
    echo "[Sandbox] Added workspace to whitelist: $target_path"
    generate_compose_override
    reload_container_if_running
  fi
}

function cmd_workspace_remove() {
  local target_raw="$1"
  if [ -z "$target_raw" ]; then
    echo "Usage: antigravity-sandbox workspace remove <path>" >&2
    return 1
  fi

  ensure_sandbox_venv
  local target_path
  target_path="$("$PYTHON_BIN" -c "import os; print(os.path.abspath(os.path.expanduser('$target_raw')))")"

  ensure_whitelist_config

  local rm_result
  rm_result="$("$PYTHON_BIN" -c "
import os, sys, yaml
cfg = '$WHITELIST_FILE'
target = '$target_path'
with open(cfg, 'r') as f:
    data = yaml.safe_load(f) or {}
workspaces = data.get('allowed_workspaces', [])
if target not in workspaces:
    matched = [w for w in workspaces if os.path.abspath(w) == target]
    if not matched:
        print('NOT_FOUND')
        sys.exit(0)
    for m in matched:
        workspaces.remove(m)
else:
    workspaces.remove(target)
data['allowed_workspaces'] = workspaces
with open(cfg, 'w') as f:
    yaml.safe_dump(data, f, default_flow_style=False, sort_keys=False)
print('REMOVED')
")"

  if [ "$rm_result" = "NOT_FOUND" ]; then
    echo "[Sandbox Warning] Workspace not found in whitelist: $target_path" >&2
    return 1
  else
    echo "[Sandbox] Removed workspace from whitelist: $target_path"
    generate_compose_override
    reload_container_if_running
  fi
}

function cmd_workspace_list() {
  ensure_sandbox_venv
  ensure_whitelist_config
  "$PYTHON_BIN" -c "
import os, yaml
cfg = '$WHITELIST_FILE'
try:
    with open(cfg, 'r') as f:
        data = yaml.safe_load(f) or {}
    workspaces = data.get('allowed_workspaces', [])
    print('==========================================================')
    print('  Whitelisted Workspaces (~/.antigravity-sandbox/whitelist.yaml)')
    print('==========================================================')
    if not workspaces:
        print('  (No workspaces whitelisted yet)')
        print('')
        print('  Add a workspace using:')
        print('    antigravity-sandbox workspace add <path>')
    else:
        for idx, ws in enumerate(workspaces, 1):
            exists = '✓ exists' if os.path.isdir(ws) else '✗ missing on host'
            print(f'  {idx}. {ws}  [{exists}]')
    print('==========================================================')
except Exception as e:
    print(f'Error reading whitelist: {e}')
"
}

function cmd_rules_list() {
  ensure_sandbox_venv
  ensure_whitelist_config
  local gemini_host_dir="${HOST_GEMINI_DIR:-$HOME/.gemini}"
  local builtin_rules_dir="$DIR/customizations/rules"
  local user_rules_dir="${HOST_SANDBOX_RULES_DIR:-$SANDBOX_DIR/rules}"
  local sandbox_gemini="${HOST_SANDBOX_GEMINI:-$SANDBOX_DIR/GEMINI.md}"
  local host_gemini="$gemini_host_dir/GEMINI.md"

  "$PYTHON_BIN" -c "
import os

builtin_dir = '$builtin_rules_dir'
user_dir = '$user_rules_dir'
host_gemini_file = '$host_gemini'
target_gemini_file = '$sandbox_gemini'

print('==========================================================')
print('  Antigravity Sandbox Rules & GEMINI.md Status')
print('==========================================================')

b_rules = [f for f in sorted(os.listdir(builtin_dir)) if not f.startswith('.') and f.lower().endswith('.md')] if os.path.isdir(builtin_dir) else []
print(f'1. Built-in Container Rules ({len(b_rules)} active):')
for r in b_rules:
    print(f'   - {r}')

u_rules = [f for f in sorted(os.listdir(user_dir)) if not f.startswith('.') and f.lower().endswith('.md')] if os.path.isdir(user_dir) else []
print(f'\n2. User Sandbox Rules (~/.antigravity-sandbox/rules/) ({len(u_rules)} active):')
if not u_rules:
    print('   (No custom rules in ~/.antigravity-sandbox/rules/)')
for r in u_rules:
    print(f'   - {r}')

has_host = os.path.isfile(host_gemini_file) and os.path.getsize(host_gemini_file) > 0
host_status = 'Present' if has_host else 'None'
print(f'\n3. Host Global Rules (~/.gemini/GEMINI.md): {host_status}')

has_compiled = os.path.isfile(target_gemini_file) and os.path.getsize(target_gemini_file) > 0
compiled_status = f'Compiled ({os.path.getsize(target_gemini_file)} bytes)' if has_compiled else 'Not compiled yet'
print(f'\n4. Target Container GEMINI.md (~/.antigravity-sandbox/GEMINI.md):')
print(f'   {compiled_status}')
print('==========================================================')
"
}

function cmd_skills_list() {
  ensure_sandbox_venv
  ensure_whitelist_config
  local gemini_host_dir="${HOST_GEMINI_DIR:-$HOME/.gemini}"
  "$PYTHON_BIN" "$DIR/scripts/skills_mount.py" \
    --whitelist "$WHITELIST_FILE" \
    --gemini-dir "$gemini_host_dir" \
    --list
}

function cmd_open() {
  ensure_whitelist_config
  local target="$SANDBOX_DIR"
  if [ -n "$1" ]; then
    if [ -e "$SANDBOX_DIR/$1" ]; then
      target="$SANDBOX_DIR/$1"
    elif [ -e "$1" ]; then
      target="$1"
    else
      echo "[Sandbox Warning] '$1' not found inside $SANDBOX_DIR, opening $SANDBOX_DIR" >&2
    fi
  fi

  echo "[Sandbox] Opening: $target"
  if command -v open >/dev/null 2>&1; then
    open "$target"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$target" >/dev/null 2>&1 || true
  else
    echo "[Sandbox] File manager opener (open/xdg-open) not available."
    echo "[Sandbox] Target path: $target"
  fi
}

case "$COMMAND" in
  workspace|ws)
    SUB_CMD="$1"
    shift || true
    case "$SUB_CMD" in
      add)
        cmd_workspace_add "$@"
        ;;
      remove|rm)
        cmd_workspace_remove "$@"
        ;;
      list|ls|"")
        cmd_workspace_list
        ;;
      *)
        echo "Unknown workspace command: $SUB_CMD" >&2
        echo "Usage: antigravity-sandbox workspace [add|remove|list]" >&2
        exit 1
        ;;
    esac
    ;;

  skills)
    SUB_CMD="$1"
    shift || true
    case "$SUB_CMD" in
      list|ls|"")
        cmd_skills_list
        ;;
      *)
        echo "Unknown skills command: $SUB_CMD" >&2
        echo "Usage: antigravity-sandbox skills [list]" >&2
        exit 1
        ;;
    esac
    ;;

  rules)
    SUB_CMD="$1"
    shift || true
    case "$SUB_CMD" in
      list|ls|"")
        compile_sandbox_rules
        cmd_rules_list
        ;;
      *)
        echo "Unknown rules command: $SUB_CMD" >&2
        echo "Usage: antigravity-sandbox rules [list]" >&2
        exit 1
        ;;
    esac
    ;;

  start)
    START_HOST_BRIDGE="true"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --no-host-bridge)
          START_HOST_BRIDGE="false"
          shift
          ;;
        --with-host-bridge)
          START_HOST_BRIDGE="true"
          shift
          ;;
        -*)
          echo "[Sandbox Warning] Unknown option for start: $1" >&2
          shift
          ;;
        *)
          echo "[Notice] 'start' no longer accepts a workspace path parameter ($1)."
          echo "[Notice] Whitelist workspaces separately with: antigravity-sandbox workspace add <path>"
          echo ""
          shift
          ;;
      esac
    done

    ensure_sandbox_venv
    ensure_whitelist_config
    compile_sandbox_rules
    generate_compose_override

    if is_container_running; then
      echo "[Sandbox] Antigravity Sandbox is already running."
      echo "[Sandbox] Web UI available at: https://127.0.0.1:58432"
      cmd_rules_list
      echo ""
      cmd_workspace_list
      echo ""
      cmd_skills_list
      exit 0
    fi

    # Pre-check port availability
    if (lsof -iTCP:58432 -sTCP:LISTEN -n -P >/dev/null 2>&1 || nc -z 127.0.0.1 58432 2>/dev/null); then
      echo "[Sandbox Warning] Port 58432 appears to be in use by an existing host process." >&2
    fi

    if [ "$START_HOST_BRIDGE" = "true" ]; then
      start_host_bridge_bg
    fi

    NUM_WORKSPACES=$("$PYTHON_BIN" -c "
import yaml
try:
    with open('$WHITELIST_FILE', 'r') as f:
        data = yaml.safe_load(f) or {}
        print(len(data.get('allowed_workspaces', [])))
except Exception:
    print(0)
")

    if [ "$NUM_WORKSPACES" -eq 0 ]; then
      echo "[Sandbox] Starting Antigravity Sandbox (0 workspaces mounted)..."
      echo "[Sandbox] You can add workspaces anytime using: antigravity-sandbox workspace add <path>"
      echo ""
      cmd_skills_list
    else
      echo "[Sandbox] Starting Antigravity Sandbox with VirtioFS..."
      cmd_rules_list
      echo ""
      cmd_workspace_list
      echo ""
      cmd_skills_list
    fi

    run_compose up -d
    echo "[Sandbox] Sandbox is running with Language Server daemon."
    echo "[Sandbox] Web UI available at: https://127.0.0.1:58432"
    ;;

  stop)
    echo "[Sandbox] Stopping Sandbox..."
    run_compose down
    stop_host_bridge
    ;;

  restart)
    START_HOST_BRIDGE="true"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --no-host-bridge)
          START_HOST_BRIDGE="false"
          shift
          ;;
        --with-host-bridge)
          START_HOST_BRIDGE="true"
          shift
          ;;
        -*)
          echo "[Sandbox Warning] Unknown option for restart: $1" >&2
          shift
          ;;
        *)
          shift
          ;;
      esac
    done

    echo "[Sandbox] Restarting Sandbox..."
    compile_sandbox_rules
    generate_compose_override
    if [ "$START_HOST_BRIDGE" = "true" ]; then
      start_host_bridge_bg
    else
      stop_host_bridge
    fi
    run_compose restart
    echo "[Sandbox] Sandbox is running with Language Server daemon."
    echo "[Sandbox] Web UI available at: https://127.0.0.1:58432"
    ;;

  build)
    echo "[Sandbox] Building/Rebuilding Sandbox image from Dockerfile.sandbox..."
    run_compose build
    ;;

  status)
    compile_sandbox_rules
    run_compose ps 2>/dev/null || true
    if is_container_running; then
      echo "[Status] Language Server daemon: Active (Listening on https://127.0.0.1:58432)"
    fi
    if is_host_bridge_running; then
      hb_pid="$(get_host_bridge_pid 2>/dev/null || true)"
      echo "[Status] Host-Exec daemon: Active (PID: $hb_pid, Listening on port 58433)"
    else
      echo "[Status] Host-Exec daemon: Inactive"
    fi
    docker stats --no-stream antigravity-sandbox 2>/dev/null || true
    echo ""
    cmd_rules_list
    echo ""
    cmd_workspace_list
    echo ""
    cmd_skills_list
    ;;

  app)
    if ! is_container_running; then
      echo "[Antigravity] Starting sandbox container first..."
      "$DIR/scripts/antigravity-sandbox" start "$@"
    fi
    echo "[Antigravity] Launching Native Desktop App connected to Sandbox (127.0.0.1:58432)..."
    APP_BIN="/Applications/Antigravity.app/Contents/MacOS/Antigravity"
    if [ -x "$APP_BIN" ]; then
      DEV_URL="https://127.0.0.1:58432" "$APP_BIN" >/dev/null 2>&1 &
    elif [ -x "/Applications/Antigravity.app/Contents/MacOS/Electron" ]; then
      DEV_URL="https://127.0.0.1:58432" "/Applications/Antigravity.app/Contents/MacOS/Electron" >/dev/null 2>&1 &
    else
      DEV_URL="https://127.0.0.1:58432" open -a "/Applications/Antigravity.app"
    fi
    ;;

  open|reveal|dir)
    cmd_open "$@"
    ;;

  host-bridge)
    SUB_CMD="$1"
    shift || true
    case "$SUB_CMD" in
      start|--bg|-d)
        start_host_bridge_bg
        ;;
      stop)
        stop_host_bridge
        ;;
      restart)
        stop_host_bridge
        start_host_bridge_bg
        ;;
      status)
        if is_host_bridge_running; then
          hb_pid="$(get_host_bridge_pid 2>/dev/null || true)"
          echo "[Status] Host-Exec daemon: Active (PID: $hb_pid, Listening on port 58433)"
        else
          echo "[Status] Host-Exec daemon: Inactive"
        fi
        ;;
      fg|run|"")
        ensure_sandbox_venv
        ensure_whitelist_config
        echo "[Bridge] Starting Host-Exec Daemon on macOS (foreground)..."
        "$PYTHON_BIN" "$DIR/bridge/host_exec_daemon.py"
        ;;
      *)
        echo "Unknown host-bridge command: $SUB_CMD" >&2
        echo "Usage: antigravity-sandbox host-bridge [start|stop|restart|status|fg]" >&2
        exit 1
        ;;
    esac
    ;;

  help|--help|-h)
    show_help
    ;;

  *)
    show_help
    ;;
esac
