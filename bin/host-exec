#!/usr/bin/env python3
"""
Antigravity Host-Exec Guest Client
Executed inside the container (or on host) to invoke whitelisted commands on host macOS.
"""

import os
import sys
import json
import socket
import hmac
import hashlib

HOST_EXEC_HOST = os.environ.get("HOST_EXEC_HOST", "host.docker.internal")
HOST_EXEC_PORT = int(os.environ.get("HOST_EXEC_PORT", "58433"))
SOCKET_PATH = os.environ.get("HOST_EXEC_SOCKET", "/var/run/host-exec/host-exec.sock")
AUTH_SECRET_FILE = "/var/run/host-exec/auth_secret.key"

if len(sys.argv) < 2:
    print("Usage: host-exec <command> [args...]")
    sys.exit(1)

cmd = sys.argv[1]
args = sys.argv[2:]
full_cmd_str = f"{cmd} {' '.join(args)}".strip()

# Read auth secret
secret = os.environ.get("HOST_EXEC_SECRET", "")
if not secret:
    secret_candidates = [
        AUTH_SECRET_FILE,
        os.path.expanduser("~/.antigravity-sandbox/ipc/auth_secret.key"),
    ]
    for sc in secret_candidates:
        if os.path.exists(sc):
            try:
                with open(sc, "r") as f:
                    secret = f.read().strip()
                if secret:
                    break
            except Exception:
                continue

if not secret:
    print(f"Host-Exec Warning: Auth secret key not found. Request may fail authentication.", file=sys.stderr)

payload_to_sign = {
    "command": cmd,
    "args": args,
    "cwd": os.getcwd()
}
canonical_bytes = json.dumps(payload_to_sign, sort_keys=True, separators=(',', ':')).encode("utf-8")
token = hmac.new(secret.encode("utf-8"), canonical_bytes, hashlib.sha256).hexdigest()

req = {
    "command": cmd,
    "args": args,
    "token": token,
    "cwd": os.getcwd()
}

sock = None
connected = False

# 1. Direct socket path check
if SOCKET_PATH and os.path.exists(SOCKET_PATH):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(SOCKET_PATH)
        s.settimeout(None)
        sock = s
        connected = True
    except Exception:
        pass

# 2. Attempt TCP connection to host
if not connected:
    hosts_to_try = []
    if HOST_EXEC_HOST:
        hosts_to_try.append(HOST_EXEC_HOST)
    if "host.docker.internal" not in hosts_to_try:
        hosts_to_try.append("host.docker.internal")
    if not os.environ.get("HOST_EXEC_HOST") and "127.0.0.1" not in hosts_to_try:
        hosts_to_try.append("127.0.0.1")

    for target_host in hosts_to_try:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.0)
            s.connect((target_host, HOST_EXEC_PORT))
            s.settimeout(None)
            sock = s
            connected = True
            break
        except Exception:
            continue

# 3. Fallback to default unix socket paths
if not connected:
    default_sockets = [
        "/var/run/host-exec/host-exec.sock",
        os.path.expanduser("~/.antigravity-sandbox/ipc/host-exec.sock"),
    ]
    for sp in default_sockets:
        if os.path.exists(sp):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(1.0)
                s.connect(sp)
                s.settimeout(None)
                sock = s
                connected = True
                break
            except Exception:
                continue

if not connected or sock is None:
    print(
        f"\n================================================================================\n"
        f"[HOST-EXEC ERROR] Host Bridge Daemon is not running on the macOS host\n"
        f"================================================================================\n"
        f"Failed to execute command: '{full_cmd_str}'\n"
        f"Reason: Could not connect to host-exec daemon at {HOST_EXEC_HOST}:{HOST_EXEC_PORT} or {SOCKET_PATH}.\n\n"
        f"REMEDIATION STEPS FOR THE AGENT:\n"
        f"1. Do NOT retry this command in an automated loop.\n"
        f"2. Inform the user that this command requires execution on their macOS host, but the host bridge daemon is not currently running.\n"
        f"3. Ask the user to start the host bridge daemon by running the following command in their host macOS terminal:\n\n"
        f"       antigravity-sandbox host-bridge\n\n"
        f"   (or: ./scripts/antigravity-sandbox host-bridge)\n\n"
        f"4. Once the user confirms the host bridge daemon is running, retry the command.\n"
        f"================================================================================\n",
        file=sys.stderr
    )
    sys.exit(127)

try:
    sock.settimeout(30.0)
    sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
    
    chunks = []
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
        if b"\n" in chunk:
            break
    
    raw_resp = b"".join(chunks).decode("utf-8", errors="replace").strip()
    if not raw_resp:
        raise ConnectionError("Host bridge daemon closed connection without returning a response.")
    resp = json.loads(raw_resp)
    
    if resp.get("status") == "success":
        sys.stdout.write(resp.get("stdout", ""))
        sys.stderr.write(resp.get("stderr", ""))
        sys.exit(resp.get("returncode", 0))
    else:
        error_msg = resp.get("message", "Unknown error from host bridge")
        print(
            f"\n================================================================================\n"
            f"[HOST-EXEC ERROR] Host Execution Failed\n"
            f"================================================================================\n"
            f"Command: '{full_cmd_str}'\n"
            f"Reason: {error_msg}\n",
            file=sys.stderr
        )
        if "whitelist" in error_msg.lower() or "violated" in error_msg.lower():
            print(
                f"REMEDIATION STEPS FOR THE AGENT:\n"
                f"1. Inform the user that '{cmd}' is not allowed by their current host security whitelist.\n"
                f"2. Instruct the user to update 'allowed_commands' in '~/.antigravity-sandbox/whitelist.json' on their macOS host if they wish to permit it.\n"
                f"================================================================================\n",
                file=sys.stderr
            )
        elif "denied by user" in error_msg.lower():
            print(
                f"REMEDIATION STEPS FOR THE AGENT:\n"
                f"1. The user denied the interactive approval dialog on macOS.\n"
                f"2. Do not retry without explicit user confirmation.\n"
                f"================================================================================\n",
                file=sys.stderr
            )
        elif "authentication" in error_msg.lower() or "hmac" in error_msg.lower():
            print(
                f"REMEDIATION STEPS FOR THE AGENT:\n"
                f"1. Ask the user to restart the host-bridge daemon on their macOS host:\n"
                f"       antigravity-sandbox host-bridge\n"
                f"================================================================================\n",
                file=sys.stderr
            )
        else:
            print(
                f"REMEDIATION STEPS FOR THE AGENT:\n"
                f"Check the error reason above and ask the user for assistance.\n"
                f"================================================================================\n",
                file=sys.stderr
            )
        sys.exit(1)
except Exception as e:
    print(
        f"\n================================================================================\n"
        f"[HOST-EXEC ERROR] Host Bridge Communication Failure\n"
        f"================================================================================\n"
        f"Command: '{full_cmd_str}'\n"
        f"Reason: {e}\n\n"
        f"REMEDIATION STEPS FOR THE AGENT:\n"
        f"1. Ask the user to ensure the host bridge daemon is running properly on macOS:\n"
        f"       antigravity-sandbox host-bridge\n"
        f"2. Retry after the user confirms it is running.\n"
        f"================================================================================\n",
        file=sys.stderr
    )
    sys.exit(127)
finally:
    sock.close()
