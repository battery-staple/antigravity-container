#!/usr/bin/env python3
"""
Antigravity Host-Exec Guest Client
Executed inside the container (or on host) to invoke whitelisted commands on host macOS.
"""

import hashlib
import hmac
import json
import os
import socket
import sys

HOST_EXEC_HOST = os.environ.get("HOST_EXEC_HOST", "host.docker.internal")
HOST_EXEC_PORT = int(os.environ.get("HOST_EXEC_PORT", "58433"))
AUTH_SECRET_FILE = "/var/run/host-exec/auth_secret.key"


def get_auth_secret() -> str:
    """Retrieve HMAC secret from environment or standard secret files."""
    secret = os.environ.get("HOST_EXEC_SECRET", "")
    if secret:
        return secret

    secret_candidates = [
        AUTH_SECRET_FILE,
        os.path.expanduser("~/.antigravity-sandbox/ipc/auth_secret.key"),
    ]
    for candidate in secret_candidates:
        if os.path.exists(candidate):
            try:
                with open(candidate, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                if content:
                    return content
            except Exception:
                continue
    return ""


def format_capabilities(commands_dict: dict) -> str:
    """Format whitelisted commands into a clean human/agent-readable table."""
    out = [
        "=" * 80,
        "AVAILABLE HOST COMMANDS (~/.antigravity-sandbox/whitelist.yaml)",
        "=" * 80,
    ]
    if not commands_dict:
        out.append("  (No commands whitelisted yet)")
    else:
        for name, info in sorted(commands_dict.items()):
            desc = info.get("description", "")
            bin_path = info.get("binary_path", "")
            regex = info.get("allowed_args_regex", ".*")
            approval = (
                "Interactive Approval Required (macOS Dialog)"
                if info.get("require_interactive_approval")
                else "Auto (No prompt)"
            )
            out.append(f"• {name}")
            if desc:
                out.append(f"  Description : {desc}")
            out.append(f"  Binary Path : {bin_path}")
            out.append(f"  Allowed Args: {regex}")
            out.append(f"  Approval    : {approval}")
            out.append("")
    out.append("=" * 80)
    return "\n".join(out)


def connect_to_daemon():
    """Attempt TCP connection to host."""
    target_host = HOST_EXEC_HOST or "host.docker.internal"
    hosts_to_try = [target_host]
    if target_host != "127.0.0.1":
        hosts_to_try.append("127.0.0.1")

    for h in hosts_to_try:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.0)
            s.connect((h, HOST_EXEC_PORT))
            s.settimeout(None)
            return s
        except Exception:
            continue

    return None


def print_daemon_offline_error(full_cmd_str: str):
    """Print structured remediation advice when the host daemon is unreachable."""
    print(
        f"\n================================================================================\n"
        f"[HOST-EXEC ERROR] Host Bridge Daemon is not running on the macOS host\n"
        f"================================================================================\n"
        f"Failed to execute command: '{full_cmd_str}'\n"
        f"Reason: Could not connect to host-exec daemon at {HOST_EXEC_HOST}:{HOST_EXEC_PORT}.\n\n"
        f"REMEDIATION STEPS FOR THE AGENT:\n"
        f"1. Do NOT retry this command in an automated loop.\n"
        f"2. Inform the user that this command requires execution on their macOS host, but the host bridge daemon is not currently running.\n"
        f"3. Ask the user to start the host bridge daemon by running the following command in their host macOS terminal:\n\n"
        f"       antigravity-sandbox host-bridge\n\n"
        f"   (or: ./scripts/antigravity-sandbox host-bridge)\n\n"
        f"4. Once the user confirms the host bridge daemon is running, retry the command.\n"
        f"================================================================================\n",
        file=sys.stderr,
    )


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help"]:
        print("Usage: host-exec <command> [args...] | host-exec --list")
        sys.exit(0 if len(sys.argv) >= 2 else 1)

    is_list_query = (sys.argv[1] == "--list")
    cmd = sys.argv[1]
    args = sys.argv[2:] if not is_list_query else []
    full_cmd_str = f"{cmd} {' '.join(args)}".strip() if not is_list_query else "host-exec --list"

    secret = get_auth_secret()
    if not secret:
        print("Host-Exec Warning: Auth secret key not found. Request may fail authentication.", file=sys.stderr)

    payload_to_sign = {
        "command": "__list__" if is_list_query else cmd,
        "args": args,
        "cwd": os.getcwd(),
    }
    canonical_bytes = json.dumps(payload_to_sign, sort_keys=True, separators=(",", ":")).encode("utf-8")
    token = hmac.new(secret.encode("utf-8"), canonical_bytes, hashlib.sha256).hexdigest()

    req_id = f"req-{os.urandom(4).hex()}"
    traj_id = os.environ.get("ANTIGRAVITY_TRAJECTORY_ID", "")

    req = {
        "command": "__list__" if is_list_query else cmd,
        "args": args,
        "token": token,
        "cwd": os.getcwd(),
        "request_id": req_id,
        "trajectory_id": traj_id,
    }

    sock = connect_to_daemon()
    if sock is None:
        print_daemon_offline_error(full_cmd_str)
        sys.exit(127)

    try:
        sock.sendall((json.dumps(req) + "\n").encode("utf-8"))

        chunks = []
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            chunks.append(chunk)
            if b"\n" in chunk:
                break

        raw_resp = b"".join(chunks).decode("utf-8", errors="replace").strip()
        if not raw_resp:
            raise ConnectionError("Host bridge daemon closed connection without returning a response.")
        resp = json.loads(raw_resp)

        if resp.get("status") == "success":
            if resp.get("type") == "capabilities" or is_list_query:
                print(format_capabilities(resp.get("allowed_commands", {})))
                sys.exit(0)
            sys.stdout.write(resp.get("stdout", ""))
            sys.stderr.write(resp.get("stderr", ""))
            sys.exit(resp.get("returncode", 0))
        else:
            error_msg = resp.get("message", "Unknown error from host bridge")
            print(
                f"\n================================================================================\n"
                f"[HOST-EXEC ERROR] Host Execution Failed\n"
                f"================================================================================\n"
                f"Command: '{full_cmd_str}'\n"
                f"Reason: {error_msg}\n",
                file=sys.stderr,
            )
            if "whitelist" in error_msg.lower() or "violated" in error_msg.lower():
                print(
                    f"REMEDIATION STEPS FOR THE AGENT:\n"
                    f"1. Run 'host-exec --list' to see all permitted macOS commands and allowed argument patterns.\n"
                    f"2. Instruct the user to update 'allowed_commands' in '~/.antigravity-sandbox/whitelist.yaml' on their macOS host if they wish to permit '{cmd}'.\n"
                    f"================================================================================\n",
                    file=sys.stderr,
                )
            elif "denied by user" in error_msg.lower():
                print(
                    f"REMEDIATION STEPS FOR THE AGENT:\n"
                    f"1. The user denied the interactive approval dialog on macOS.\n"
                    f"2. Do not retry without explicit user confirmation.\n"
                    f"================================================================================\n",
                    file=sys.stderr,
                )
            elif "authentication" in error_msg.lower() or "hmac" in error_msg.lower():
                print(
                    f"REMEDIATION STEPS FOR THE AGENT:\n"
                    f"1. Ask the user to restart the host-bridge daemon on their macOS host:\n"
                    f"       antigravity-sandbox host-bridge\n"
                    f"================================================================================\n",
                    file=sys.stderr,
                )
            else:
                print(
                    f"REMEDIATION STEPS FOR THE AGENT:\n"
                    f"Check the error reason above and ask the user for assistance.\n"
                    f"================================================================================\n",
                    file=sys.stderr,
                )
            sys.exit(1)
    except Exception as e:
        print(
            f"\n================================================================================\n"
            f"[HOST-EXEC ERROR] Host Bridge Communication Failure\n"
            f"================================================================================\n"
            f"Command: '{full_cmd_str}'\n"
            f"Reason: {e}\n\n"
            f"REMEDIATION STEPS FOR THE AGENT:\n"
            f"1. Ask the user to ensure the host bridge daemon is running properly on macOS:\n"
            f"       antigravity-sandbox host-bridge\n"
            f"2. Retry after the user confirms it is running.\n"
            f"================================================================================\n",
            file=sys.stderr,
        )
        sys.exit(127)
    finally:
        sock.close()


if __name__ == "__main__":
    main()
