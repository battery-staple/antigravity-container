# ==============================================================================
# Google Antigravity Container Sandbox
# ==============================================================================
# A secure, high-performance containerized runtime designed for the Google
# Antigravity Desktop App backend and agent execution engine.
#
# Key Architectural Characteristics:
# 1. Isolation: Runs agent commands inside an isolated Linux namespace.
# 2. Filesystem: Mounts project code directly via VirtioFS with sub-millisecond sync.
# 3. Persistence: Named Docker volumes preserve user dotfiles, package caches,
#    and agent memory (~/.gemini/antigravity).
# 4. Multi-Arch: Fully supports Apple Silicon (arm64) and Intel (amd64) Macs.
# ==============================================================================

FROM ubuntu:24.04 AS base

# ------------------------------------------------------------------------------
# 1. Environment & Locale Configuration
# ------------------------------------------------------------------------------
# Prevent interactive frontend prompts during apt-get package installations
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ------------------------------------------------------------------------------
# 2. System Packages & Build Foundations
# ------------------------------------------------------------------------------
# Installs:
# - Core networking and security: ca-certificates, curl, wget, git, openssh-client
# - Compilation and build toolchains: build-essential (gcc, g++, make), pkg-config, libssl-dev
# - Python 3 runtime, pip, and virtual environment support
# - Interactive developer shells and process inspection tools: zsh, tmux, htop, jq
# - Headless Chromium & Electron shared libraries (required if the backend spawns sidecars)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    build-essential \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    zsh \
    tmux \
    htop \
    jq \
    unzip \
    zip \
    sudo \
    socat \
    openssh-client \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libc6 \
    libcairo2 \
    libcups2t64 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc-s1 \
    libglib2.0-0t64 \
    libgtk-3-0t64 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 3. Node.js & JavaScript Toolchains
# ------------------------------------------------------------------------------
# Installs Node.js v22 (LTS) from the official NodeSource repository along with
# standard package managers (yarn, pnpm, bun) for modern web development.
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && npm install -g npm@latest yarn pnpm bun \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 4. Go Toolchain (v1.23)
# ------------------------------------------------------------------------------
# Downloads and installs official Go binaries with dynamic architecture resolution
# supporting both Apple Silicon (arm64) and Intel x86_64 (amd64).
ARG TARGETARCH
RUN GO_ARCH=${TARGETARCH:-arm64} && \
    if [ "$GO_ARCH" = "amd64" ]; then GO_BIN_ARCH="amd64"; else GO_BIN_ARCH="arm64"; fi && \
    curl -fsSL https://go.dev/dl/go1.23.0.linux-${GO_BIN_ARCH}.tar.gz -o /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz

# ------------------------------------------------------------------------------
# 5. Developer User & Permission Setup
# ------------------------------------------------------------------------------
# Configure a dedicated non-root developer user with matching host UID/GID to
# ensure seamless file ownership over bind-mounted workspace files.
#
# Note on macOS GID 20: On macOS, standard users belong to group 'staff' (GID 20).
# On Ubuntu, GID 20 is the existing system group 'dialout'. The check below avoids
# collision errors when GID 20 is passed from macOS.
ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=1000

RUN if getent group $USER_GID >/dev/null 2>&1; then \
        useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    else \
        groupadd --gid $USER_GID $USERNAME && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    fi \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# ------------------------------------------------------------------------------
# 6. Persistent Directories & Ownership
# ------------------------------------------------------------------------------
# Pre-create all required directory hierarchies for the developer user:
# - /workspace: Mount target for the host project directory (via VirtioFS)
# - /home/$USERNAME/.gemini/antigravity: Antigravity agent state & logs
# - /home/$USERNAME/.npm-global: Rootless global npm package installations
# - /home/$USERNAME/go/bin: User Go binaries
# - /var/run/host-exec: Host-Exec bridge socket directory
# - /etc/antigravity/customizations: Image templates for agent rules & skills
RUN mkdir -p \
    /workspace \
    /home/$USERNAME/.gemini/antigravity \
    /home/$USERNAME/.antigravity-bin \
    /home/$USERNAME/.npm-global \
    /home/$USERNAME/go/bin \
    /var/run/host-exec \
    /etc/antigravity/customizations \
    && chown -R $USER_UID:$USER_GID /workspace /home/$USERNAME /var/run/host-exec

# ------------------------------------------------------------------------------
# 7. Environment Variables for Developer User
# ------------------------------------------------------------------------------
# Configure paths so global tools installed via npm, pip, cargo, and go
# are immediately accessible in interactive subshells without root privileges.
ENV NPM_CONFIG_PREFIX="/home/developer/.npm-global"
ENV GOPATH="/home/developer/go"
ENV PATH="/home/developer/go/bin:/home/developer/.npm-global/bin:/usr/local/go/bin:/home/developer/.cargo/bin:/home/developer/.local/bin:$PATH"
ENV WORKSPACE="/workspace"

# ------------------------------------------------------------------------------
# 8. Agent Customizations & Host Bridge Installation
# ------------------------------------------------------------------------------
# Copy agent environment awareness rule and host-exec skill into image templates
COPY customizations /etc/antigravity/customizations

# Install container entrypoint, host-exec guest CLI bridge, and browser xdg-open bridge
COPY security/entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
COPY bin/host-exec /usr/local/bin/host-exec
COPY bin/xdg-open /usr/local/bin/xdg-open
RUN chmod +x /usr/local/bin/sandbox-entrypoint.sh /usr/local/bin/host-exec /usr/local/bin/xdg-open

# ------------------------------------------------------------------------------
# 9. Runtime Execution Context
# ------------------------------------------------------------------------------
WORKDIR /workspace
USER $USERNAME

# Expose Antigravity Language Server port (loopback bound by docker-compose)
EXPOSE 58432

ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]
CMD ["start-ls"]
